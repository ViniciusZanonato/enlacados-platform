# =============================================================
# ENLAÇADOS — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ----------------------------
# Frontend (Vite) — exposed to browser, prefix VITE_
# ----------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key

# Sentry — monitoramento de erros em produção (obrigatório em prod)
VITE_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ----------------------------
# Supabase — Vercel Functions (server-side only, nunca expor no frontend)
# ----------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key

# ----------------------------
# Stripe (payments — Vercel Functions)
# ----------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
